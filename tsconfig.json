{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "NodeNext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    // "declaration": true,  -- These declaration files are useful when you're building a library that other developers will install from npm.
    // "declarationMap": true, -- We're building an application, not a reusable library.

    // Stricter Typechecking Options
    // "noUncheckedIndexedAccess": true,
    // "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true, -- I don't want to introduce them before you've built a few APIs.
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    // "jsx": "react-jsx", -- We're building a backend, not a React frontend Remove for now
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // "noUncheckedSideEffectImports": true, -- It's useful in some projects but isn't necessary for learning or for our Authentication Service.
    // "moduleDetection": "force", - This controls how TypeScript detects modules [[It's fine, but we don't need to explicitly set it for this project.]]
    "skipLibCheck": true,
  }
}
